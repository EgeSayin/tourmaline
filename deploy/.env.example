# The database password: a long random one in letters and digits, as it goes into a URL, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# The port the app listens on, on this machine. Put a reverse proxy with HTTPS in front of it.
PORT=3000

# Which release to run; `latest` follows each new one.
TOURMALINE_VERSION=latest

# true runs the public demo instead: a guest workspace per visitor, and no accounts.
DEMO_MODE=false
