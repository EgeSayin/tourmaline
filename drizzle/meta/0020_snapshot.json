      "checkConstraints": {
        "items_kind": {
          "name": "items_kind",
          "value": "case \"items\".\"timing\"\n        when 'fixed' then num_nonnulls(\"items\".\"start_at\", \"items\".\"end_at\", \"items\".\"buffer_before_min\", \"items\".\"buffer_after_min\") = 4\n          and num_nonnulls(\"items\".\"duration_min\", \"items\".\"earliest_start\", \"items\".\"deadline\", \"items\".\"split_min_chunk_min\", \"items\".\"split_max_chunk_min\", \"items\".\"spread\") = 0\n          and \"items\".\"start_at\" < \"items\".\"end_at\" and \"items\".\"buffer_before_min\" >= 0 and \"items\".\"buffer_after_min\" >= 0\n        else num_nonnulls(\"items\".\"duration_min\", \"items\".\"earliest_start\", \"items\".\"deadline\", \"items\".\"spread\") = 4\n          and num_nonnulls(\"items\".\"start_at\", \"items\".\"end_at\", \"items\".\"location\", \"items\".\"buffer_before_min\", \"items\".\"buffer_after_min\") = 0\n          and \"items\".\"earliest_start\" < \"items\".\"deadline\" and \"items\".\"duration_min\" > 0 and \"items\".\"duration_min\" % 5 = 0\n      end"
        },
        "items_split": {
          "name": "items_split",
          "value": "(\"items\".\"split_min_chunk_min\" is null) = (\"items\".\"split_max_chunk_min\" is null) and (\"items\".\"split_min_chunk_min\" is null or (\"items\".\"split_min_chunk_min\" between 1 and \"items\".\"split_max_chunk_min\" and \"items\".\"split_min_chunk_min\" % 5 = 0 and \"items\".\"split_max_chunk_min\" % 5 = 0))"
        }
      },
